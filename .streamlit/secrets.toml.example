# Copy this file to `.streamlit/secrets.toml` for local development.
# DO NOT commit secrets.toml — it is in .gitignore.
#
# For Streamlit Cloud: paste the [aws_credentials] block into
# https://share.streamlit.io → app → Settings → Secrets.

[aws_credentials]
AWS_ACCESS_KEY_ID     = "ASIA..."
AWS_SECRET_ACCESS_KEY = "..."
AWS_SESSION_TOKEN     = "..."          # required for AWS Academy temp creds
AWS_REGION            = "us-east-1"
AWS_BUCKET            = "sagemaker-us-east-1-537272162042"
AWS_ENDPOINT          = "fraud-detection-endpoint"
